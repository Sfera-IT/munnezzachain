{
  "name": "munnezzachain",
  "version": "1.0.0",
  "description": "Segnalazioni ambientali con foto a catena di custodia verificabile (PWA + Cloudflare Workers)",
  "scripts": {
    "build": "node scripts/build-web.ts",
    "dev": "node scripts/build-web.ts --dev && wrangler dev",
    "typecheck": "wrangler types >/dev/null && tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.sw.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply munnezzachain --local",
    "db:migrate:remote": "wrangler d1 migrations apply munnezzachain --remote",
    "create-admin": "node scripts/create-admin.ts",
    "deploy": "npm run typecheck && npm test && node scripts/build-web.ts && wrangler deploy --var APP_VERSION:$(cat .app-version)",
    "icons": "node scripts/make-icons.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amargiovanni/munnezzachain.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/amargiovanni/munnezzachain/issues"
  },
  "homepage": "https://github.com/amargiovanni/munnezzachain#readme",
  "dependencies": {
    "hono": "^4.13.8",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": false
  },
  "private": true,
  "license": "UNLICENSED"
}
